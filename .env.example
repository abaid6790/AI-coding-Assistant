# This single .env file configures the backend (server/). The frontend
# needs no env var in dev — Vite proxies /api to the backend (see
# vite.config.js). VITE_API_BASE_URL only matters for a production
# build where the frontend is served separately from the backend:
# VITE_API_BASE_URL=https://api.example.com

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (leave unset to use local SQLite in data/database/app.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_coding_assistant

# Frontend origin (for CORS + links in emails)
FRONTEND_ORIGIN=http://localhost:5173

# Cookies
SESSION_COOKIE_SECURE=false

# Mail (set MAIL_SUPPRESS_SEND=false once real SMTP creds are configured)
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com

# Gemini keys — add as many as you have for rotation
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Additional providers (not implemented yet — see server/services/ai/providers/)
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
